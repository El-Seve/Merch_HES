# --- Modo de la app ---
# demo = no toca OneDrive, guarda fotos localmente en /backend/data/demo-fotos (para probar todo el flujo)
# produccion = sube de verdad a OneDrive vía rclone
MODO=demo

# --- Seguridad de sesión (invéntalo, cualquier cadena larga y aleatoria) ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- OneDrive vía rclone (solo necesario en MODO=produccion) ---
# 1. Instala rclone en TU PC (rclone.org/downloads) y corre `rclone config` una vez
#    para autorizar tu cuenta personal de Microsoft (ver README, sección "Conectar OneDrive").
# 2. Abre el archivo rclone.conf que se generó, copia TODO su contenido tal cual,
#    y pégalo aquí como valor de esta variable (puede tener varias líneas).
RCLONE_CONFIG_CONTENT=

# Carpeta raíz dentro del OneDrive donde se organizarán las evidencias
ONEDRIVE_ROOT_FOLDER=Merch_HES

# Puerto del servidor
PORT=3000
