# --- Modo de la app ---
# demo = no toca OneDrive, guarda fotos localmente en /backend/data/demo-fotos (para probar todo el flujo)
# produccion = sube de verdad a OneDrive vía Microsoft Graph
MODO=demo

# --- Seguridad de sesión (invéntalo, cualquier cadena larga y aleatoria) ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Azure AD App Registration (solo necesarios en MODO=produccion) ---
# Se obtienen registrando una app gratuita en https://portal.azure.com
# Tipo de cuenta admitida: "Cuentas personales de Microsoft únicamente" (OneDrive personal, gratis)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=consumers
AZURE_REDIRECT_URI=http://localhost:3000/auth/onedrive/callback

# Carpeta raíz dentro del OneDrive donde se organizarán las evidencias
ONEDRIVE_ROOT_FOLDER=Merch_HES

# Puerto del servidor
PORT=3000
